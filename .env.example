# Copy to .env and adjust. Any Postgres 14+ works; only the URL matters.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruiter_bot
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruiter_bot_test

# Scoring weights: decimal strings, each >= 0, skills and experience > 0, exact sum of 1.
W_SKILLS=0.60
W_EXPERIENCE=0.25
W_CULTURE=0.15

# Server-side cap on every SQL statement.
DB_STATEMENT_TIMEOUT_MS=5000
