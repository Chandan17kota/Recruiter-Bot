  "info": {
    "description": "Explainable, bidirectional candidate–job matching over hand-written SQL.",
    "title": "Recruiter Bot",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/candidates": {
      "get": {
        "operationId": "list_candidates_candidates_get",
        "parameters": [
          {
            "description": "Repeatable: ?availability=immediate&availability=two_weeks",
            "in": "query",
            "name": "availability",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "$ref": "#/components/schemas/Availability"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Repeatable: ?availability=immediate&availability=two_weeks",
              "title": "Availability"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandidateListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "All candidates"
      }
    },
    "/candidates/{candidate_id}/matches": {
      "get": {
        "operationId": "candidate_matches_candidates__candidate_id__matches_get",
        "parameters": [
          {
            "in": "path",
            "name": "candidate_id",
            "required": true,
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "title": "Candidate Id",
              "type": "integer"
            }
          },
          {
            "description": "Drop matches whose unrounded score is below this (0–100)",
            "in": "query",
            "name": "min_score",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 100.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ],
              "default": "0",
              "description": "Drop matches whose unrounded score is below this (0–100)",
              "title": "Min Score"
            }
          },
          {
            "description": "Drop matches whose required-skill coverage % is below this (0–100)",
            "in": "query",
            "name": "min_skill_coverage",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 100.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ],
              "default": "0",
              "description": "Drop matches whose required-skill coverage % is below this (0–100)",
              "title": "Min Skill Coverage"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandidateMatchesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ranked jobs for a candidate"
      }
    },
